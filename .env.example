# ==============================================
# ResearchPilot AI - Environment Configuration
# Global AI Hackathon - Tavily Research Agent
# ==============================================

# Required for live web intelligence
TAVILY_API_KEY=

# Required for Gemini AI research analysis
GEMINI_API_KEY=

# Optional: MongoDB connection string for persistent research history
# Example: mongodb://localhost:27017 or mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=researchpilot_ai

# Optional Model & Runtime Tuning
GEMINI_MODEL=gemini-3.5-flash-lite
REQUEST_TIMEOUT_SECONDS=45
MAX_SEARCH_RESULTS_PER_QUERY=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
